# Server-only — never prefix with NEXT_PUBLIC_
# Shared secret for HIQ public leads ingest (X-API-Key header).
HIQ_LEADS_API_KEY=

# HIQ API origin with no trailing slash (e.g. https://api.example.com)
HIQ_BASE_URL=

# ── Self-hosted search (Meilisearch — free OSS, no Algolia-style billing) ───
# Local: docker compose up -d meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_ADMIN_API_KEY=dev_master_key_local_only
MEILISEARCH_INDEX_NAME=horeca_products
# auto | meilisearch | nlp — auto uses Meilisearch when HOST is set, else NLP fallback
SEARCH_PROVIDER=auto
# Secret for POST /api/search/sync (optional; falls back to REVALIDATION_SECRET)
SEARCH_SYNC_SECRET=
